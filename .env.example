# Copy to .env for local development, or add these values in your deploy platform.
# Never commit real secrets.

SERVER_PORT=8081
# Render sets PORT automatically. Local development can use SERVER_PORT.
# PORT=8081

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/Sneaky
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_FORMAT_SQL=false

# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_32_byte_base64_secret

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# Keep false unless Kafka is running locally.
APP_KAFKA_ENABLED=false
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_CONSUMER_GROUP_ID=sneaky-analytics
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_PRODUCER_MAX_BLOCK_MS=1000
APP_KAFKA_TOPIC_USER_ACTIVITY=sneaky.user-activity

# Comma-separated list. Add your deployed frontend origin here.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use Secure=true and SameSite=None when frontend/backend are on different HTTPS origins.
APP_AUTH_REFRESH_COOKIE_SECURE=false
APP_AUTH_REFRESH_COOKIE_SAME_SITE=Lax

# Login rate limit: 3 attempts per 5 minutes.
APP_RATE_LIMIT_LOGIN_LIMIT=3
APP_RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
APP_RATE_LIMIT_REGISTER_LIMIT=3
APP_RATE_LIMIT_REGISTER_WINDOW_SECONDS=300
APP_RATE_LIMIT_REFRESH_LIMIT=30
APP_RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
APP_RATE_LIMIT_PUBLIC_READ_LIMIT=240
APP_RATE_LIMIT_PUBLIC_READ_WINDOW_SECONDS=60
APP_RATE_LIMIT_USER_MUTATION_LIMIT=60
APP_RATE_LIMIT_USER_MUTATION_WINDOW_SECONDS=60
APP_RATE_LIMIT_ANALYTICS_LIMIT=60
APP_RATE_LIMIT_ANALYTICS_WINDOW_SECONDS=60

# Seeds sample products when active products are below this count.
APP_SEED_PRODUCTS_ENABLED=true
APP_SEED_PRODUCTS_MINIMUM_COUNT=150
